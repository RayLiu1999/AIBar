// 系統匣圖示與右鍵選單（規格書第 7 節）
export component Tray inherits SystemTrayIcon {
    // 圖示由 Rust 端依用量動態產生
    in property <image> tray-icon;
    in property <string> tray-tooltip: "AIBar";
    // 各 Provider 是否啟用
    in-out property <bool> claude-enabled: true;
    in-out property <bool> codex-enabled: true;

    callback left-clicked();
    callback enabled-changed();
    callback refresh-now();
    callback show-about();
    callback quit();

    icon: tray-icon;
    tooltip: tray-tooltip;
    clicked => {
        root.left-clicked();
    }

    changed claude-enabled => {
        root.enabled-changed();
    }
    changed codex-enabled => {
        root.enabled-changed();
    }

    Menu {
        MenuItem {
            title: "Claude";
            checkable: true;
            checked <=> root.claude-enabled;
        }
        MenuItem {
            title: "Codex";
            checkable: true;
            checked <=> root.codex-enabled;
        }
        MenuSeparator { }
        MenuItem {
            title: "立即刷新";
            activated => {
                root.refresh-now();
            }
        }
        MenuItem {
            title: "關於";
            activated => {
                root.show-about();
            }
        }
        MenuItem {
            title: "結束";
            activated => {
                root.quit();
            }
        }
    }
}

// 系統匣圖示與右鍵選單（規格書第 7 節）
export component Tray inherits SystemTrayIcon {
    // 圖示由 Rust 端依焦點 Provider 的剩餘量動態繪製
    in property <image> tray-icon;
    in property <string> tray-tooltip: "AIBar";

    callback left-clicked();
    callback refresh-now();
    callback open-settings();
    callback show-about();
    callback quit();

    icon: tray-icon;
    tooltip: tray-tooltip;
    clicked => {
        root.left-clicked();
    }

    Menu {
        MenuItem {
            title: "立即刷新";
            activated => {
                root.refresh-now();
            }
        }
        MenuItem {
            title: "設定…";
            activated => {
                root.open-settings();
            }
        }
        MenuItem {
            title: "關於";
            activated => {
                root.show-about();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "結束";
            activated => {
                root.quit();
            }
        }
    }
}

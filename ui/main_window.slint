// 主視窗：頂部頁籤（總覽＋各 Provider），規格書第 7 節
import { Spinner, Palette, ScrollView, Button } from "std-widgets.slint";

// 依剩餘量分級：normal ≥30%、low 10–29%、critical <10%
export enum UsageLevel { normal, low, critical }

// 一個額度視窗
export struct WindowRow {
    name: string,
    value-text: string,   // 「剩餘 72%」或「已使用 28%」
    bar: float,           // 進度條長度（0–100），依顯示方式
    mark: float,          // 進度刻度位置（0–100）；-1 表示不顯示
    pace-text: string,    // 「比預期少用 32% · 可撐到重置」；空字串表示不顯示
    reset-text: string,   // 「2 時 1 分後重置」
    reset-abs: string,    // 「今天 01:10」；只在 Provider 頁籤顯示
    level: UsageLevel,
}

// 一個 Provider 的內容（由 Rust 端的 view::card 產生）
export struct CardData {
    id: string,
    name: string,
    mono: string,          // 字母方塊上的字
    accent: color,         // 代表色
    plan: string,
    rows: [WindowRow],
    has-snapshot: bool,
    updated-text: string,
    stale: bool,
    failure: string,       // 空字串表示最近一次刷新成功
    notice: string,        // 非錯誤的提示（例如 Antigravity 未執行）
    failure-cmd: string,   // 可複製的修復指令（例如 claude）；空字串表示沒有
    credits-text: string,  // 金額型額度：「本期已用 $4.33 / $10.00」
    resets-text: string,   // 保留重置摘要：「已存 2 次重置・最快 11/20（五）08:00 到期」；空字串表示沒有
    resets-detail: string, // 保留重置明細：每次一行到期時間，最後一行是套用方式
    resets-soon: bool,     // 最快到期的重置快到期了
    refreshing: bool,
    source: string,
    usage-url: string,
    next-refresh: string,
}

// 配色：跟隨 Windows 深色／淺色模式
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #ffffff;
    out property <color> card-border: dark ? #383838 : #e2e2e2;
    out property <color> divider: dark ? #353535 : #e8e8e8;
    out property <color> text: dark ? #f3f3f3 : #1b1b1b;
    out property <color> subtext: dark ? #ababab : #5c5c5c;
    out property <color> track: dark ? #3d3d3d : #e3e3e3;
    out property <color> chip-bg: dark ? #3a3a3a : #ececec;
    out property <color> hover: dark ? #2d2d2d : #e9e9e9;
    out property <color> marker: dark ? #f3f3f3 : #1b1b1b;
    out property <color> low: dark ? #F2B544 : #b7791f;
    out property <color> critical: dark ? #F06A5E : #c53030;
    out property <color> warn-bg: dark ? #3a3020 : #fdf3dc;
    out property <color> warn-border: dark ? #6b5426 : #e8c97a;
    out property <color> warn-text: dark ? #f5dca6 : #6b4a0b;

    public pure function level-color(level: UsageLevel, accent: color) -> color {
        level == UsageLevel.critical ? critical : level == UsageLevel.low ? low : accent
    }
}

// 頁籤
component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> show-dot;
    in property <color> accent: Theme.text;

    callback clicked();
    // 被選取時回報自己的位置，讓頁籤列捲動到看得見的地方
    callback revealed(length, length);

    changed selected => {
        if (self.selected) {
            self.revealed(self.x, self.width);
        }
    }

    min-width: lay.preferred-width;
    height: 40px;
    border-radius: 4px;
    background: ta.has-hover && !root.selected ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;

    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.show-dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.accent;
            }
        }
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: root.selected ? 700 : 400;
            color: root.selected ? Theme.text : Theme.subtext;
            vertical-alignment: center;
        }
    }

    // 選取指示線
    Rectangle {
        x: 8px;
        y: parent.height - 2px;
        width: parent.width - 16px;
        height: 2px;
        border-radius: 1px;
        background: root.selected ? root.accent : transparent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 只有圖示的按鈕（圖示以 16×16 的 SVG 路徑描邊）
component IconButton inherits Rectangle {
    in property <string> label;
    in property <string> commands;
    in property <length> stroke-width: 1.5px;

    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;

    Path {
        x: 10px;
        y: 10px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.commands;
        stroke: Theme.text;
        stroke-width: root.stroke-width;
        fill: transparent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 代表色字母方塊
component Monogram inherits Rectangle {
    in property <string> text;
    in property <color> accent;
    in property <length> size: 22px;

    width: root.size;
    height: root.size;
    border-radius: root.size * 0.27;
    background: root.accent;

    Text {
        text: root.text;
        font-size: root.size * 0.55;
        font-weight: 700;
        color: #1b1b1b;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 方案標籤，例如「Max 5x」
component PlanChip inherits Rectangle {
    in property <string> text;

    background: Theme.chip-bg;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            font-size: 11px;
            color: Theme.subtext;
            vertical-alignment: center;
        }
    }
}

// 一個額度視窗：名稱與數值｜進度條（含進度刻度）｜進度說明
component WindowLine inherits VerticalLayout {
    in property <WindowRow> usage;
    in property <color> accent;
    in property <bool> detail;

    spacing: 6px;
    padding-top: 10px;
    padding-bottom: 10px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.usage.name;
            font-size: root.detail ? 15px : 14px;
            font-weight: 700;
            color: Theme.text;
            horizontal-stretch: 0;
        }
        Text {
            text: root.usage.value-text;
            font-size: root.detail ? 15px : 14px;
            font-weight: 700;
            color: root.usage.level == UsageLevel.normal ? Theme.text : Theme.level-color(root.usage.level, root.accent);
            horizontal-stretch: 0;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: root.usage.reset-text;
            font-size: 12px;
            color: Theme.subtext;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }

    bar := Rectangle {
        height: root.detail ? 10px : 8px;
        border-radius: self.height / 2;
        background: Theme.track;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * max(0, min(1, root.usage.bar / 100));
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.level-color(root.usage.level, root.accent);
        }

        // 進度刻度：依時間比例此刻應剩（或應已使用）的位置
        if root.usage.mark >= 0: Rectangle {
            x: parent.width * max(0, min(1, root.usage.mark / 100)) - 1px;
            y: -3px;
            width: 2px;
            height: parent.height + 6px;
            border-radius: 1px;
            background: Theme.marker;
        }
    }

    if root.usage.pace-text != "" || (root.detail && root.usage.reset-abs != ""): HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.usage.pace-text;
            font-size: 12px;
            color: Theme.subtext;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        if root.detail: Text {
            text: root.usage.reset-abs;
            font-size: 12px;
            color: Theme.subtext;
            horizontal-stretch: 0;
        }
    }
}

// 額度視窗清單（視窗之間有分隔線）
component WindowList inherits VerticalLayout {
    in property <[WindowRow]> rows;
    in property <color> accent;
    in property <bool> detail;

    for row[i] in root.rows: VerticalLayout {
        if i > 0: Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        WindowLine {
            usage: row;
            accent: root.accent;
            detail: root.detail;
        }
    }
}

// 總覽中的一張 Provider 卡片
component ProviderCard inherits Rectangle {
    in property <CardData> data;

    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 4px;
        padding-left: 14px;
        padding-right: 14px;

        HorizontalLayout {
            spacing: 8px;
            padding-bottom: 4px;
            Monogram {
                text: root.data.mono;
                accent: root.data.accent;
            }
            Text {
                text: root.data.name;
                font-size: 15px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            if root.data.plan != "": VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                PlanChip {
                    text: root.data.plan;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.data.refreshing: Spinner {
                indeterminate: true;
                width: 16px;
                height: 16px;
            }
            if root.data.has-snapshot && !root.data.refreshing: Text {
                text: root.data.updated-text;
                font-size: 12px;
                color: root.data.stale ? Theme.low : Theme.subtext;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }

        if root.data.credits-text != "": Text {
            text: root.data.credits-text;
            font-size: 12px;
            color: Theme.subtext;
        }

        if root.data.resets-text != "": Text {
            text: root.data.resets-text;
            font-size: 12px;
            color: root.data.resets-soon ? Theme.low : Theme.subtext;
            wrap: word-wrap;
        }

        if root.data.has-snapshot: WindowList {
            rows: root.data.rows;
            accent: root.data.accent;
            detail: false;
        }

        if root.data.failure != "": Text {
            text: "⚠ " + root.data.failure;
            font-size: 12px;
            color: Theme.low;
            wrap: word-wrap;
        }

        if root.data.notice != "": Text {
            text: root.data.notice;
            font-size: 12px;
            color: Theme.subtext;
            wrap: word-wrap;
        }
        Rectangle {
            height: 8px;
        }
    }
}

// Provider 頁籤的內容
component ProviderDetail inherits VerticalLayout {
    in property <CardData> data;

    callback refresh();
    callback copy-text(string);
    callback open-url(string);

    spacing: 14px;

    // 大標題
    HorizontalLayout {
        spacing: 12px;
        Monogram {
            text: root.data.mono;
            accent: root.data.accent;
            size: 40px;
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.data.name;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-stretch: 0;
                }
                if root.data.plan != "": VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    PlanChip {
                        text: root.data.plan;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.data.refreshing ? "刷新中…" : root.data.updated-text;
                font-size: 12px;
                color: root.data.stale ? Theme.low : Theme.subtext;
            }
        }
        if root.data.refreshing: VerticalLayout {
            alignment: center;
            Spinner {
                indeterminate: true;
                width: 18px;
                height: 18px;
            }
        }
    }

    // 失敗提示框
    if root.data.failure != "": Rectangle {
        background: Theme.warn-bg;
        border-width: 1px;
        border-color: Theme.warn-border;
        border-radius: 8px;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: "⚠ " + root.data.failure + (root.data.has-snapshot ? "。下方為最後一次成功取得的數字。" : "");
                font-size: 13px;
                color: Theme.warn-text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.data.failure-cmd != "": Button {
                    text: "複製指令 " + root.data.failure-cmd;
                    clicked => {
                        root.copy-text(root.data.failure-cmd);
                    }
                }
                Button {
                    text: "重試";
                    clicked => {
                        root.refresh();
                    }
                }
            }
        }
    }

    if root.data.notice != "": Text {
        text: root.data.notice + (root.data.has-snapshot ? "。下方為最後一次取得的數字。" : "");
        font-size: 13px;
        color: Theme.subtext;
        wrap: word-wrap;
    }

    if root.data.has-snapshot: Rectangle {
        background: Theme.card-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.card-border;

        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 2px;
            padding-bottom: 2px;
            WindowList {
                rows: root.data.rows;
                accent: root.data.accent;
                detail: true;
            }
        }
    }

    // 資訊列
    GridLayout {
        spacing-horizontal: 12px;
        spacing-vertical: 8px;
        Row {
            Text {
                text: "來源";
                font-size: 13px;
                color: Theme.subtext;
            }
            Text {
                text: root.data.source;
                font-size: 13px;
                color: Theme.text;
                horizontal-stretch: 1;
            }
        }
        if root.data.credits-text != "": Row {
            Text {
                text: "費用";
                font-size: 13px;
                color: Theme.subtext;
            }
            Text {
                text: root.data.credits-text;
                font-size: 13px;
                color: Theme.text;
            }
        }
        if root.data.resets-text != "": Row {
            Text {
                text: "重置";
                font-size: 13px;
                color: Theme.subtext;
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.data.resets-text;
                    font-size: 13px;
                    color: root.data.resets-soon ? Theme.low : Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.data.resets-detail;
                    font-size: 12px;
                    color: Theme.subtext;
                    wrap: word-wrap;
                }
            }
        }
        Row {
            Text {
                text: "下次刷新";
                font-size: 13px;
                color: Theme.subtext;
            }
            Text {
                text: root.data.next-refresh;
                font-size: 13px;
                color: Theme.text;
            }
        }
    }

    if root.data.usage-url != "": HorizontalLayout {
        alignment: start;
        Button {
            text: "開啟官方用量頁";
            clicked => {
                root.open-url(root.data.usage-url);
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <[CardData]> cards;
    // 總覽最上方：「最先用完：Codex 每週，剩 59%」
    in property <string> headline;
    // 0 為總覽，n 為 cards[n - 1]
    in property <int> selected-tab;

    callback refresh-all();
    callback hide-requested();
    callback tab-selected(int);
    callback copy-text(string);
    callback open-url(string);
    callback open-settings();

    title: "AIBar";
    preferred-width: 460px;
    preferred-height: 640px;
    min-width: 380px;
    min-height: 300px;
    background: Theme.window-bg;

    // 按 Esc 隱藏回托盤
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.hide-requested();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // 頁籤列
            Rectangle {
                height: 46px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    padding-top: 4px;
                    spacing: 2px;

                    // 頁籤超出視窗寬度時可橫向捲動，右側按鈕永遠留在畫面上
                    Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0;

                    tabs := Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-width: max(self.width, tab-row.preferred-width);
                        content-height: self.height;

                        // 只能橫向捲動，讓一般的上下滾輪也能左右捲
                        TouchArea {
                            width: tabs.content-width;
                            height: tabs.height;
                            scroll-event(event) => {
                                if (tabs.content-width <= tabs.width) {
                                    return reject;
                                }
                                tabs.content-x = clamp(tabs.content-x + event.delta-y + event.delta-x, tabs.width - tabs.content-width, 0px);
                                accept
                            }
                        }

                        tab-row := HorizontalLayout {
                            height: tabs.height;
                            spacing: 2px;
                            TabButton {
                                text: "總覽";
                                selected: root.selected-tab == 0;
                                clicked => {
                                    root.tab-selected(0);
                                }
                                revealed(x, w) => {
                                    tabs.reveal(x, w);
                                }
                            }
                            for card[i] in root.cards: TabButton {
                                text: card.name;
                                show-dot: true;
                                accent: card.accent;
                                selected: root.selected-tab == i + 1;
                                clicked => {
                                    root.tab-selected(i + 1);
                                }
                                revealed(x, w) => {
                                    tabs.reveal(x, w);
                                }
                            }
                        }

                        // 捲動到被選取的頁籤，讓它完整出現在可見範圍內
                        function reveal(x: length, w: length) {
                            if (x + self.content-x < 0) {
                                self.content-x = -x;
                            } else if (x + w + self.content-x > self.width) {
                                self.content-x = self.width - x - w;
                            }
                        }
                    }

                    // 兩側漸層：提示還有頁籤藏在外面
                    if tabs.content-x < 0: Rectangle {
                        x: 0;
                        width: 24px;
                        height: tabs.height;
                        background: @linear-gradient(90deg, Theme.window-bg 0%, Theme.window-bg.transparentize(100%) 100%);
                    }
                    if tabs.content-x > tabs.width - tabs.content-width: Rectangle {
                        x: parent.width - 24px;
                        width: 24px;
                        height: tabs.height;
                        background: @linear-gradient(90deg, Theme.window-bg.transparentize(100%) 0%, Theme.window-bg 100%);
                    }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            label: "立即刷新";
                            commands: "M 13.5 8 A 5.5 5.5 0 1 1 11.9 4.1 M 13.5 1.5 L 13.5 4.6 L 10.4 4.6";
                            clicked => {
                                root.refresh-all();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            label: "設定";
                            stroke-width: 1.2px;
                            commands: "M 6.81 2.84 L 6.97 1.08 A 7.0 7.0 0 0 1 9.03 1.08 L 9.19 2.84 A 5.3 5.3 0 0 1 10.81 3.51 L 12.16 2.37 A 7.0 7.0 0 0 1 13.63 3.84 L 12.49 5.19 A 5.3 5.3 0 0 1 13.16 6.81 L 14.92 6.97 A 7.0 7.0 0 0 1 14.92 9.03 L 13.16 9.19 A 5.3 5.3 0 0 1 12.49 10.81 L 13.63 12.16 A 7.0 7.0 0 0 1 12.16 13.63 L 10.81 12.49 A 5.3 5.3 0 0 1 9.19 13.16 L 9.03 14.92 A 7.0 7.0 0 0 1 6.97 14.92 L 6.81 13.16 A 5.3 5.3 0 0 1 5.19 12.49 L 3.84 13.63 A 7.0 7.0 0 0 1 2.37 12.16 L 3.51 10.81 A 5.3 5.3 0 0 1 2.84 9.19 L 1.08 9.03 A 7.0 7.0 0 0 1 1.08 6.97 L 2.84 6.81 A 5.3 5.3 0 0 1 3.51 5.19 L 2.37 3.84 A 7.0 7.0 0 0 1 3.84 2.37 L 5.19 3.51 A 5.3 5.3 0 0 1 6.81 2.84 Z M 10.2 8 A 2.2 2.2 0 1 1 5.8 8 A 2.2 2.2 0 1 1 10.2 8 Z";
                            clicked => {
                                root.open-settings();
                            }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.divider;
                }
            }

            scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: list.preferred-height;

                list := VerticalLayout {
                    width: scroll.visible-width;
                    padding: 14px;
                    spacing: 12px;

                    if root.selected-tab == 0 && root.headline != "": Text {
                        text: root.headline;
                        font-size: 13px;
                        color: Theme.subtext;
                    }

                    if root.selected-tab == 0: VerticalLayout {
                        spacing: 12px;
                        for card in root.cards: ProviderCard {
                            data: card;
                        }
                    }

                    if root.selected-tab > 0: ProviderDetail {
                        data: root.cards[root.selected-tab - 1];
                        refresh => {
                            root.refresh-all();
                        }
                        copy-text(text) => {
                            root.copy-text(text);
                        }
                        open-url(url) => {
                            root.open-url(url);
                        }
                    }

                    if root.cards.length == 0: Text {
                        text: "沒有啟用的 Provider，請按右上角的設定按鈕啟用。";
                        font-size: 13px;
                        color: Theme.subtext;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    init => {
        fs.focus();
    }
}

// 主視窗：每個啟用的 Provider 一張精簡卡片，每個額度視窗一行（規格書第 7 節）
import { Spinner, Palette, ScrollView, Button } from "std-widgets.slint";

// 用量等級，決定進度條與百分比的顏色
export enum UsageLevel { normal, high, critical }

// 卡片中的一個額度視窗
export struct UsageRow {
    name: string,
    percent: float,       // 0–100，已重置時為 0
    percent-text: string,
    reset-text: string,   // 「2 時 13 分後」「11/12（四）14:59」「已重置」
    level: UsageLevel,
}

// 一個 Provider 的卡片內容（由 Rust 端的 view::card 產生）
export struct CardData {
    name: string,
    plan: string,          // 空字串表示沒有方案標籤
    rows: [UsageRow],
    has-snapshot: bool,
    updated-text: string,  // 「更新於 N 分鐘前」
    stale: bool,           // 舊快照：更新時間改用警示色
    failure: string,       // 空字串表示最近一次刷新成功
    refreshing: bool,
}

// 配色：跟隨 Windows 深色／淺色模式
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #ffffff;
    out property <color> card-border: dark ? #383838 : #e5e5e5;
    out property <color> text: dark ? #ffffff : #1b1b1b;
    out property <color> subtext: dark ? #a6a6a6 : #5f5f5f;
    out property <color> track: dark ? #454545 : #e6e6e6;
    out property <color> chip-bg: dark ? #3a3a3a : #ededed;
    out property <color> warning: dark ? #fcd34d : #b45309;
    out property <color> normal: #22c55e;
    out property <color> high: #eab308;
    out property <color> critical: #ef4444;

    public pure function level-color(level: UsageLevel) -> color {
        level == UsageLevel.critical ? critical : level == UsageLevel.high ? high : normal
    }
}

// 進度條
component UsageBar inherits Rectangle {
    in property <float> percent;
    in property <UsageLevel> level;

    height: 6px;
    border-radius: 3px;
    background: Theme.track;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * max(0, min(1, root.percent / 100));
        height: parent.height;
        border-radius: parent.border-radius;
        background: Theme.level-color(root.level);
    }
}

// 方案標籤，例如「Max 5x」
component PlanChip inherits Rectangle {
    in property <string> text;

    background: Theme.chip-bg;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            font-size: 11px;
            color: Theme.subtext;
            vertical-alignment: center;
        }
    }
}

// 一個額度視窗：名稱｜進度條｜百分比｜重置時間
component UsageLine inherits HorizontalLayout {
    in property <UsageRow> usage;

    spacing: 8px;
    Text {
        width: 76px;
        text: root.usage.name;
        font-size: 12px;
        color: Theme.text;
        overflow: elide;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        UsageBar {
            percent: root.usage.percent;
            level: root.usage.level;
        }
    }
    Text {
        width: 36px;
        text: root.usage.percent-text;
        font-size: 12px;
        font-weight: 600;
        color: Theme.level-color(root.usage.level);
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        width: 104px;
        text: root.usage.reset-text;
        font-size: 11px;
        color: Theme.subtext;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component ProviderCard inherits Rectangle {
    in property <CardData> data;

    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;

        // 標題列：名稱、方案；右側為刷新中轉圈或更新時間
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.data.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            if root.data.plan != "": VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                PlanChip { text: root.data.plan; }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.data.refreshing: Spinner {
                indeterminate: true;
                width: 14px;
                height: 14px;
            }
            // 舊快照的更新時間用警示色
            if root.data.has-snapshot && !root.data.refreshing: Text {
                text: root.data.updated-text;
                font-size: 11px;
                color: root.data.stale ? Theme.warning : Theme.subtext;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }

        for row in root.data.rows: UsageLine {
            usage: row;
        }

        // 失敗原因（與快照並存顯示）
        if root.data.failure != "": Text {
            text: "⚠ " + root.data.failure;
            font-size: 12px;
            color: Theme.warning;
            wrap: word-wrap;
        }
    }
}

export component MainWindow inherits Window {
    in property <[CardData]> cards;
    // 視窗圖示（工作列按鈕）與托盤圖示同步，顏色隨用量變化
    in property <image> window-icon;

    callback refresh-all();
    callback hide-requested();

    title: "AIBar";
    icon: root.window-icon;
    preferred-width: 420px;
    preferred-height: 360px;
    min-width: 360px;
    min-height: 200px;
    background: Theme.window-bg;

    // 按 Esc 隱藏回托盤
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.hide-requested();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            // 工具列
            HorizontalLayout {
                padding-left: 2px;
                Text {
                    text: "AI 用量";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.subtext;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "↻ 立即刷新";
                    clicked => {
                        root.refresh-all();
                    }
                }
            }

            // 內容超出視窗高度時捲動
            scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: list.preferred-height;

                list := VerticalLayout {
                    width: scroll.visible-width;
                    spacing: 8px;

                    for card in root.cards: ProviderCard {
                        data: card;
                    }

                    if root.cards.length == 0: Text {
                        text: "沒有啟用的 Provider，請從托盤右鍵選單啟用。";
                        font-size: 12px;
                        color: Theme.subtext;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    init => {
        fs.focus();
    }
}
